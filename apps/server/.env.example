# Settings for `pnpm --filter server dev`. Copy this file to apps/server/.env,
# which git ignores, and fill in JWT_SECRET there. Never commit a real secret.

# At least 32 random bytes; generate one with: openssl rand -base64 48
JWT_SECRET=

# The SQLite database file, created on first start (relative to apps/server).
DATABASE_PATH=newcord.db
