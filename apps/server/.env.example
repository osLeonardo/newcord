# Settings for `pnpm --filter server dev`. Copy this file to apps/server/.env,
# which git ignores, and fill in JWT_SECRET there. Never commit a real secret.

# At least 32 random bytes; generate one with: openssl rand -base64 48
JWT_SECRET=

# The SQLite database file, created on first start (relative to apps/server).
DATABASE_PATH=newcord.db

# The secret shared with coturn's use-auth-secret (#8); at least 32 random bytes:
# openssl rand -base64 48. coturn must be started with the same value.
RELAY_SECRET=

# The relay's addresses, separated by commas, as Devices reach it. In development,
# use your PC's address on the local network, for example:
# RELAY_URLS=stun:192.168.1.10:3478,turn:192.168.1.10:3478
RELAY_URLS=
