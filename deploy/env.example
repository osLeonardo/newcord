# The backend's settings in production, as /etc/newcord/env (owned by the newcord
# user, chmod 600). This copy holds no secret: generate each one ON THE MACHINE with
#   openssl rand -base64 48

JWT_SECRET=
# The same value goes into coturn's static-auth-secret in /etc/turnserver.conf.
RELAY_SECRET=

RELAY_URLS=stun:newcord-turn.duckdns.org:3478,turn:newcord-turn.duckdns.org:3478,turns:newcord-turn.duckdns.org:443
DATABASE_PATH=/var/lib/newcord/newcord.db

# Behind nginx: listen only on this machine, and believe nginx's client address.
LISTEN_HOST=127.0.0.1
TRUST_PROXY=127.0.0.1

# For the backup, as /etc/newcord/backup.env:
# NEWCORD_BACKUP_BUCKET=<private bucket name>
